APP_SHARED_PASSWORD=choose-a-strong-passphrase
JWT_SECRET=replace-with-a-long-random-secret

# Provider-scoped secrets:
# - use OPENAI_API_KEY whenever either selected model uses the `openai` provider
# - use ANTHROPIC_API_KEY whenever either selected model uses the `anthropic` provider
# Do not create separate planner/advisor API key variables.

PLANNER_PROVIDER=anthropic
PLANNER_MODEL=claude-haiku-5-5
ADVISOR_PROVIDER=anthropic
ADVISOR_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Comma-separated browser origins allowed to call the Worker (CORS)
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
